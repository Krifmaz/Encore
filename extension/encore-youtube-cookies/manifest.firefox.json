{
  "manifest_version": 3,
  "name": "Encore – YouTube sign-in",
  "short_name": "Encore YouTube",
  "version": "0.0.0",
  "description": "Hands a YouTube sign-in to your Encore server (from a private window, so Encore owns it), or syncs this browser's YouTube cookies.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Encore – YouTube sign-in",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-cookies@encore.local",
      "strict_min_version": "128.0"
    }
  }
}
