{
  "manifest_version": 3,
  "name": "Encore – YouTube sign-in",
  "short_name": "Encore YouTube",
  "version": "0.0.0",
  "description": "Sends this browser's YouTube cookies to your Encore server, so its YouTube Music downloads stay signed in.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.google.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Encore – YouTube sign-in" },
  "icons": { "128": "icon.png" },
  "browser_specific_settings": { "gecko": { "id": "youtube-cookies@encore.local", "strict_min_version": "128.0" } }
}
