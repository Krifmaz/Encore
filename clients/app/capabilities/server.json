{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "server",
  "description": "The user's Encore server (any http/https origin the window was pointed at): what window.EncoreNative needs.",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["http://*:*/*", "https://*:*/*"] },
  "permissions": ["allow-now-playing", "allow-page-alive", "allow-change-server", "allow-open-offline", "allow-save-offline"]
}
