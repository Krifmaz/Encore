{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own pages (server picker, offline player, mini player): every command.",
  "windows": ["main", "mini"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-now-playing", "allow-page-alive", "allow-servers", "allow-connect", "allow-remove-server", "allow-change-server",
    "allow-retry-server", "allow-open-offline", "allow-offline-list", "allow-offline-ids", "allow-remove-offline", "allow-save-offline",
    "allow-engine-login", "allow-engine-logout", "allow-engine-status",
    "allow-desktop-settings", "allow-set-desktop-settings", "allow-mini-player", "allow-mini-state", "allow-player-control",
    "allow-check-update", "allow-install-update", "allow-offline-play-songs", "allow-offline-engine", "allow-offline-engine-status"
  ]
}
