# Omnistall manifest for the Encore desktop app – schema 1, reference: docs/MANIFEST.md in
# github.com/Krifmaz/Omnistall. This file is a template: scripts/installer-manifest.sh <version> <out> fills
# {version} everywhere (app.version, the release tag, the asset names, the icon URL) and, when given a SHA256SUMS
# file, swaps each `checksum_asset` line for that payload's `sha256`. The installer job in
# .github/workflows/apps.yml brands Omnistall (built from the commit in clients/installer/OMNISTALL_REV) with the
# result; scripts/release-apps.sh --installer does the same on your own machine.
#
# The asset names are exactly what the desktop job's Collect step in apps.yml names the Tauri payloads
# (Encore-Setup-<v>.exe, Encore-<v>-mac.dmg, Encore-<v>-linux-x86_64.AppImage). When the payload names change in
# 0.27 (the Iced app replaces Tauri: new file names, new install paths) only this file changes – the workflow,
# the scripts and the pin file stay as they are.
#
# No sha256 here: every source names the release's SHA256SUMS file (release.yml writes it over every asset right
# before publishing), so the installer can be built beside the payloads instead of after them, and a payload
# rebuilt later with scripts/release-apps.sh stays installable (the script updates SHA256SUMS).
schema = 1

[app]
name = "encore"
display_name = "Encore"
version = "{version}"
description = "Your self-hosted Encore music server in its own window: media keys, tray and lock-screen controls, with the Cadenza playback engine on this computer."
publisher = "Krifmaz"
homepage = "https://github.com/Krifmaz/Encore"
license = "MIT"
icon = "https://raw.githubusercontent.com/Krifmaz/Encore/v{version}/clients/app/icons/128x128@2x.png"
kind = "gui"

# Windows: the Tauri NSIS setup, run silently. tauri.conf.json sets bundle.windows.nsis.installMode = currentUser,
# so it installs to %LOCALAPPDATA%\Encore without UAC and writes uninstall.exe next to the app. The binary keeps
# the crate name (encore-app.exe): Tauri 2 only renames it when mainBinaryName is set, and it is not.
[sources.windows-x86_64]
type = "github"
repo = "Krifmaz/Encore"
tag = "v{version}"
asset = "Encore-Setup-{version}.exe"
checksum_asset = "SHA256SUMS"
format = "exe"

# macOS: the universal .dmg with Encore.app (Intel and Apple Silicon in one bundle), so one source for both CPUs.
[sources.macos]
type = "github"
repo = "Krifmaz/Encore"
tag = "v{version}"
asset = "Encore-{version}-mac.dmg"
checksum_asset = "SHA256SUMS"
format = "dmg"

# Linux: the AppImage, x86_64 only – the desktop job builds no aarch64 payload, which is why there is no aarch64
# installer either. Omnistall copies it to ~/.local/share/omnistall/apps/encore/ and writes the desktop entry.
[sources.linux-x86_64]
type = "github"
repo = "Krifmaz/Encore"
tag = "v{version}"
asset = "Encore-{version}-linux-x86_64.AppImage"
checksum_asset = "SHA256SUMS"
format = "appimage"

[install.windows]
# Tauri's NSIS flags: /S silent, /NS none of its own shortcuts (the installer makes the ones ticked under Options).
installer_args = ["/S", "/NS"]
executable = "%LOCALAPPDATA%\\Encore\\encore-app.exe"
uninstall_command = "\"%LOCALAPPDATA%\\Encore\\uninstall.exe\" /S"

[install.macos]
app_bundle = "Encore.app"

# One shortcut: Start Menu / Desktop .lnk on Windows, the desktop entry on Linux (exec defaults to the installed
# executable, the icon to app.icon); on macOS the bundle shows up in Launchpad by itself.
[[shortcuts]]
name = "Encore"
comment = "Your Encore music server in a window"
categories = ["AudioVideo", "Audio", "Player"]
