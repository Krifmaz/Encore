<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Files (features/files): an upload to the server keeps the app running until it ends (UploadService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Offline songs (features/offline): Android 8–9 write Music/Encore as plain files; Android 10+ use MediaStore,
         which needs no permission for the app's own files -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Updates (features/update): install a newer, verified APK of this app through a PackageInstaller session.
         The second one lets Android 12+ skip the confirm screen for an update to this same app (Android may still ask). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Encore Lyrics car app: a point-of-interest app allowed the map templates, drawing the lyrics on the map surface -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- usesCleartextTraffic: self-hosted servers are often plain http on the LAN -->
    <application
        android:name=".EncoreApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Encore"
        android:usesCleartextTraffic="true">

        <!-- configChanges: turning the phone, folding or resizing it (split screen, a window on a desktop), a keyboard
             and dark mode no longer make the activity again. Compose lays the same screen out for the new size, so
             the open page, its scroll and what it loaded stay; without this every turn reloaded Home from scratch. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Share to Encore": a link from any app becomes a download request (POST /api/requests/link) -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@style/Theme.Encore.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- One playback service for the phone UI, the notification / lock screen and Android Auto -->
        <service
            android:name=".playback.EncorePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Files: uploads to the server go on while the app is in the background, with their progress as the
             notification; stops itself when the batch ends -->
        <service
            android:name=".features.files.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Media buttons (Bluetooth / headset play) after the process died or a reboot: starts the service, which
             resumes the last queue through onPlaybackResumption -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Album covers as content:// URIs for Android Auto and the system media UI (they can't send our auth) -->
        <provider
            android:name=".playback.CoverProvider"
            android:authorities="${applicationId}.covers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Updates: the install session's outcome (only the session's own PendingIntent reaches it) -->
        <receiver
            android:name=".features.update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Bug reports: an export (cacheDir/shared/) handed to the share sheet (res/xml/file_paths.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Encore Lyrics: a second car app (template app, category POI, not navigation) showing the playing song's
             synced lyrics on the map surface of MapWithContentTemplate (car/LyricsCarAppService.kt) -->
        <service
            android:name=".car.LyricsCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/car_lyrics_label">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- MapWithContentTemplate needs car API level 7 (androidx.car.app 1.7) -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
