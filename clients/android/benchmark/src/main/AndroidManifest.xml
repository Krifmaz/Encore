<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the self-instrumenting test APK see the app it measures (package visibility on Android 11+): the release
     build, and the debug build the StrictMode / JankStats pass drives (benchmark/ci/run.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="app.encore.client" />
        <package android:name="app.encore.client.debug" />
    </queries>
</manifest>
