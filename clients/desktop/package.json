{
  "name": "encore-desktop",
  "productName": "Encore",
  "version": "1.0.0",
  "description": "Encore desktop app \u2013 your Encore music server in a window, with media keys and a tray.",
  "main": "main.js",
  "author": "Encore",
  "license": "MIT",
  "homepage": "https://github.com/Krifmaz/Encore",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.encore.desktop",
    "productName": "Encore",
    "artifactName": "Encore-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "maintainer": "Encore <encore@localhost>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Encore-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Krifmaz",
        "repo": "Encore"
      }
    ],
    "portable": {
      "artifactName": "Encore-Portable-${version}.${ext}"
    }
  }
}
