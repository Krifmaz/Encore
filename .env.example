# Copy to .env and adjust. Everything here can also be changed later in Settings.
PUID=1000
PGID=1000
TZ=Europe/London

ENCORE_ADMIN_USER=admin
ENCORE_ADMIN_PASSWORD=change-me-please
ENCORE_CONTACT_EMAIL=you@example.com

# Host paths
MUSIC_DIR=/srv/media/music
DOWNLOADS_DIR=/srv/downloads

# Lidarr (internal address)
LIDARR_API_KEY=

# slskd (internal address) – also set this key in slskd's config
SLSKD_API_KEY=generate-a-long-random-string
SLSK_USERNAME=
SLSK_PASSWORD=
