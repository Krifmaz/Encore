# Copy to .env and adjust. Everything here can also be changed later in Settings.
PUID=1000
PGID=1000
TZ=Europe/London

ENCORE_ADMIN_USER=admin
ENCORE_ADMIN_PASSWORD=change-me-please
ENCORE_CONTACT_EMAIL=you@example.com

# Host paths (absolute – relative paths break under Portainer & co.)
APPDATA=/opt/appdata
MUSIC_DIR=/srv/media/music
DOWNLOADS_DIR=/srv/downloads

# Soulseek, run by Encore (install the Soulseek (slskd) plugin under Settings → Plugins).
# A new username + password creates the account at the first sign-in.
# Don't use the same login in another Soulseek client at the same time.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# Optional: audio fingerprint verification (free key from acoustid.org/new-application)
ACOUSTID_API_KEY=

# Optional: YouTube Music sign-in (Google OAuth client, type "TVs and Limited Input devices")
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=

# Optional: Qobuz/Tidal/Deezer via streamrip with your own subscription (needs the streamrip plugin, Settings → Plugins)
STREAMRIP_ENABLED=false
STREAMRIP_DEEZER_ARL=

# Optional: torrents & Usenet through Prowlarr (needs the Torrents & Usenet (Prowlarr) plugin and your client's
# plugin, Settings → Plugins).
# TORRENT_CLIENT: qbittorrent, transmission, deluge, rtorrent or blackhole
# NZB_CLIENT: sabnzbd, nzbget or blackhole
#TORZNAB_ENABLED=true
#PROWLARR_URL=http://prowlarr:9696
#PROWLARR_API_KEY=
#TORRENT_CLIENT=qbittorrent
#QBIT_URL=http://qbittorrent:8080
#TRANSMISSION_URL=http://transmission:9091
#TRANSMISSION_USER=
#TRANSMISSION_PASSWORD=
#DELUGE_URL=http://deluge:8112
#DELUGE_PASSWORD=
#RTORRENT_URL=http://rutorrent:8080/RPC2
#RTORRENT_USER=
#RTORRENT_PASSWORD=
#TORRENT_BLACKHOLE_WATCH=/downloads/watch
#TORRENT_BLACKHOLE_COMPLETED=/downloads/torrents
#NZB_CLIENT=sabnzbd
#SAB_URL=http://sabnzbd:8080
#NZBGET_URL=http://nzbget:6789
#NZBGET_USER=nzbget
#NZBGET_PASSWORD=
#NZB_BLACKHOLE_WATCH=/downloads/watch
#NZB_BLACKHOLE_COMPLETED=/downloads/usenet
